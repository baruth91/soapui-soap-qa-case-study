<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:qa:accounts:v1" xmlns:a="urn:qa:accounts:v1" elementFormDefault="qualified">
  <xs:simpleType name="Money"><xs:restriction base="xs:decimal"><xs:fractionDigits value="2"/><xs:minInclusive value="0.01"/><xs:maxInclusive value="1000000.00"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="AccountId"><xs:restriction base="xs:string"><xs:pattern value="[A-Z][0-9]{3}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="RequestId"><xs:restriction base="xs:string"><xs:pattern value="[a-zA-Z0-9-]{1,64}"/></xs:restriction></xs:simpleType>
  <xs:element name="GetAccountRequest"><xs:complexType><xs:sequence><xs:element name="accountId" type="a:AccountId"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="GetAccountResponse"><xs:complexType><xs:sequence><xs:element name="accountId" type="a:AccountId"/><xs:element name="currency" type="xs:string"/><xs:element name="balance" type="xs:decimal"/><xs:element name="transferCount" type="xs:nonNegativeInteger"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="TransferRequest"><xs:complexType><xs:sequence><xs:element name="requestId" type="a:RequestId"/><xs:element name="fromAccount" type="a:AccountId"/><xs:element name="toAccount" type="a:AccountId"/><xs:element name="amount" type="a:Money"/><xs:element name="currency" type="xs:string"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="TransferResponse"><xs:complexType><xs:sequence><xs:element name="requestId" type="a:RequestId"/><xs:element name="status" type="xs:string"/><xs:element name="fromBalance" type="xs:decimal"/><xs:element name="toBalance" type="xs:decimal"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="BusinessFault"><xs:complexType><xs:sequence><xs:element name="code" type="xs:string"/><xs:element name="message" type="xs:string"/></xs:sequence></xs:complexType></xs:element>
</xs:schema>
